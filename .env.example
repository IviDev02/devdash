# Copia este archivo como .env (todo es opcional)

# Usuario de GitHub que se muestra al abrir el dashboard
GITHUB_USER=IviDev02

# Token personal de GitHub (sin permisos especiales). Sube el límite
# de la API de 60 a 5.000 peticiones por hora.
# GITHUB_TOKEN=ghp_xxx

# Docker: por defecto usa /var/run/docker.sock (Linux/macOS) o
# //./pipe/docker_engine (Windows). También admite tcp://host:2375
# DOCKER_HOST=unix:///var/run/docker.sock

# auto (Docker si está disponible, si no demo) | docker | demo
# DOCKER_MODE=auto

# true = no se pueden arrancar/parar contenedores desde el dashboard
# READONLY=false

# Por defecto solo escucha en tu propio ordenador. Usa 0.0.0.0 para
# abrirlo a tu red (cuidado: da control sobre tus contenedores).
# HOST=127.0.0.1
# PORT=4100
